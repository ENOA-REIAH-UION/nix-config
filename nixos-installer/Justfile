# List all the just commands
default:
    @just --list

# Check that the installer flake evaluates and the NixOS system can be built
[linux]
check:
  nix flake check --show-trace --print-build-logs

# Build the installer system without installing it
[linux]
build:
  nix build .#nixosConfigurations.ai.config.system.build.toplevel --show-trace --print-build-logs

# Install the ai host onto /mnt after preparing disks with disko
[linux]
install:
  nixos-install --root /mnt --flake .#ai --no-root-password
